# ==============================================================================
# KTPD CLIENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Base URL
# - Local Development: http://localhost:5000/api (or leave empty to use Vite proxy /api)
# - Production (Netlify): Set this in Netlify Environment Variables to your Render backend URL:
#   Example: https://ktpd-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
