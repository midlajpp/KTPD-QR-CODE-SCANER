# ==============================================================================
# KTPD SERVER - ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION / LOCAL)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cloud Database Connection String
# Example: mongodb+srv://ktpd_admin:YourStrongPassword123@cluster0.mongodb.net/ktpd_production?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ktpd_production?retryWrites=true&w=majority

# JWT Signing Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL (For CORS and QR profile link generation)
# In production on Render, set this to your Netlify site URL:
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Super Admin Provisioning (Configured in Render Environment Variables)
ADMIN_USERNAME=admin
ADMIN_EMAIL=ktpd2018.uae@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_FULL_NAME=KTPD Super Admin
