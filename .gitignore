# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
client/dist/

# Environment files - strictly exclude all active .env configs
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# Database Backups & Snapshots (sensitive member records)
backups/
server/backups/*
!server/backups/latest_fields.json
*.json.bak
*.bak

# User Uploads (logos, photos, design assets)
uploads/
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/design/
server/uploads/design/*
!server/uploads/design/.gitkeep

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage
coverage/
.nyc_output/

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
